<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local copies of the published 0.0.1-preview packages; see the trial guide. -->
    <add key="ArchPrecept" value="src/artifacts/archprecept-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ArchPrecept">
      <package pattern="ArchPrecept.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

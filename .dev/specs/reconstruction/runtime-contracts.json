{
  "schemaVersion": "1.0",
  "messagingConfiguration": {
    "section": "Messaging",
    "profileValues": ["InMemory", "Kafka", "RabbitMq"],
    "kafkaConnection": "Messaging:Kafka:ConnectionString",
    "rabbitMqConnection": "Messaging:RabbitMq:ConnectionString (absolute amqp/amqps URI)",
    "rule": "All six reconstructed hosts use this shared contract; legacy QUEUE_SERVICE/BrokerConnectionString selection is observed-only and must not be copied."
  },
  "hosts": [
    { "name": "SaleProducts.WebApi", "type": "ASP.NET Core", "context": "Products", "http": true, "database": "Products", "publishes": ["products.integration.events configured only"], "listens": [], "durability": "gap until product publication requirement and message store are selected" },
    { "name": "SaleProducts.Consumer", "type": "Generic Host", "context": "Products", "http": false, "publishes": [], "listens": ["orders.integration.events"], "businessHandler": "gap" },
    { "name": "SaleOrders.WebApi", "type": "ASP.NET Core", "context": "Orders", "http": true, "database": "Orders", "publishes": ["orders.integration.events", "inventory.requests"], "listens": ["orders.outbound.replies as reply endpoint"], "durability": "PostgreSQL source outbox plus Wolverine PostgreSQL message store" },
    { "name": "SaleOrders.Consumer", "type": "Generic Host", "context": "Orders", "http": false, "publishes": [], "listens": ["products.integration.events"], "businessHandler": "gap" },
    { "name": "InventoryControl.WebApi", "type": "ASP.NET Core", "context": "Inventory", "http": true, "database": "Inventory", "publishes": ["inventory.integration.events", "request replies"], "listens": ["inventory.requests"], "durability": "Wolverine PostgreSQL message store for external profiles" },
    { "name": "InventoryControl.Consumer", "type": "Generic Host", "context": "Inventory", "http": false, "publishes": [], "listens": ["orders.integration.events"], "businessHandler": "gap" }
  ],
  "profileBehavior": {
    "InMemory": ["stub external transports", "use deterministic local queues", "do not require broker connection", "disable database-polled Orders outbox relay when configured for tests"],
    "Kafka": ["auto-provision configured topics for lab use", "use durable inbox/outbox where a PostgreSQL Wolverine store is configured", "inventory.requests and orders.outbound.replies process inline with listener count 3"],
    "RabbitMq": ["auto-provision lab queues", "use the same logical channel names", "inventory.requests and orders.outbound.replies process inline with listener count 3", "physical exchange/binding/DLQ names remain deferred"]
  },
  "webHostCommon": ["controllers", "OpenAPI and Scalar in Development", "HTTPS redirection", "authorization middleware", "explicit Application and Infrastructure DI", "OpenTelemetry OTLP"],
  "telemetry": { "logs": ["OTLP"], "traces": ["ASP.NET Core on APIs", "Wolverine", "RabbitMQ", "Kafka", "OTLP"], "metrics": ["runtime", "process", "ASP.NET Core on APIs", "Wolverine", "OTLP"], "defaultOtlpEndpoint": "http://localhost:4317", "environmentOverride": "OTEL_EXPORTER_OTLP_ENDPOINT" },
  "containers": { "runtime": "Linux-compatible .NET 10", "dockerfiles": 6, "restoreRule": "copy entry and recursive ProjectReference project files before restore, then copy source and publish", "compose": ["three APIs", "three Consumers", "three PostgreSQL databases", "Kafka and Kafdrop", "OTel Collector", "Prometheus", "Tempo", "Loki", "Grafana"] },
  "versions": { "dotnetSdk": "10.0.302", "postgres": "16-alpine", "kafka": "4.0.0", "wolverine": "5.32.1", "dapper": "2.1.72", "npgsql": "10.0.2", "scalar": "2.14.3" },
  "environmentGates": ["Kafka connectivity", "RabbitMQ connectivity", "PostgreSQL failure injection", "container topology", "OTLP export"],
  "outcomeRule": "blocked-by-environment is never passed"
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-yuchia" value="https://nuget.pkg.github.com/YuChia-Wei/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github-yuchia">
      <package pattern="ArchPrecept.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

# Reference-only severity baseline. The target owner must review every value.
# Supported severities: none, silent, suggestion, warning, error.
# A warning fails only when the target build treats warnings as errors.

[*.cs]

dotnet_diagnostic.DBA1001.severity = error
dotnet_diagnostic.DBA1002.severity = error
dotnet_diagnostic.DBA1003.severity = warning
dotnet_diagnostic.DBA1004.severity = warning
dotnet_diagnostic.DBA1005.severity = error
dotnet_diagnostic.DBA1006.severity = error
dotnet_diagnostic.DBA1007.severity = warning
dotnet_diagnostic.DBA1008.severity = warning
dotnet_diagnostic.DBA1009.severity = warning
dotnet_diagnostic.DBA1010.severity = error
dotnet_diagnostic.DBA1011.severity = error
dotnet_diagnostic.DBA1012.severity = error
dotnet_diagnostic.DBA1013.severity = warning
dotnet_diagnostic.DBA1014.severity = error
dotnet_diagnostic.DBA1015.severity = error
dotnet_diagnostic.DBA1016.severity = error
dotnet_diagnostic.DBA1017.severity = error

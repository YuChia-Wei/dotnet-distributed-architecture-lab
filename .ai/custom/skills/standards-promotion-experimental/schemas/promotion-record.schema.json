{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "standards-promotion record 1.0.0",
  "description": "Structural contract; operation, history, authority, raw-byte and write semantics remain tool-owned. Source presence does not establish runtime acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "owner",
    "id",
    "status",
    "revision",
    "created_at",
    "updated_at",
    "content",
    "successor",
    "observation",
    "provenance",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "standards-promotion"
    },
    "owner": {
      "const": "project"
    },
    "id": {
      "type": "string",
      "pattern": "^promotion-[0-9a-f]{32}$"
    },
    "status": {
      "enum": [
        "proposed",
        "withdrawn",
        "superseded"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "successor": {
      "anyOf": [
        {
          "$ref": "#/$defs/lineage"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/observation"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      },
      "minItems": 0
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history_entry"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "utf8",
        "observed_at"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "utf8": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "config_path",
        "config_sha256",
        "binding"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "config_path": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "id",
        "schema_version",
        "store_root",
        "snapshot"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "store_root": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "role",
        "id",
        "schema_version",
        "store_root",
        "snapshot"
      ],
      "properties": {
        "relation": {
          "const": "derived-from"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "store_root": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "target_id",
        "baseline",
        "replacement",
        "rationale",
        "applicability",
        "conflicts",
        "sources",
        "target_binding",
        "after_sha256",
        "subject_sha256"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "$ref": "#/$defs/snapshot"
        },
        "replacement": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "disposition",
              "reason"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "preserve",
                  "replace",
                  "supersede",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "schema_version",
              "reason",
              "snapshot"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "schema_version": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "snapshot": {
                "$ref": "#/$defs/snapshot"
              }
            }
          },
          "minItems": 1
        },
        "target_binding": {
          "$ref": "#/$defs/binding"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "adoption",
        "rule_content",
        "effect",
        "authority_basis",
        "adoption_snapshot",
        "rule_snapshot",
        "effect_snapshot",
        "diagnostics"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "adoption": {
          "enum": [
            "adopted",
            "rejected",
            "revoked",
            "unresolved"
          ]
        },
        "rule_content": {
          "enum": [
            "matches-proposal",
            "drifted",
            "missing",
            "unresolved"
          ]
        },
        "effect": {
          "enum": [
            "effective",
            "inactive",
            "unresolved"
          ]
        },
        "authority_basis": {
          "const": "project-owned-local-evidence"
        },
        "adoption_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "previous_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "successor",
        "observation"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "successor": {
          "anyOf": [
            {
              "$ref": "#/$defs/lineage"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_revision",
        "operation",
        "recorded_at",
        "reason",
        "previous_sha256",
        "previous_status",
        "previous_state"
      ],
      "properties": {
        "from_revision": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "revise",
            "reconcile",
            "withdraw",
            "supersede"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "previous_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previous_status": {
          "enum": [
            "proposed",
            "withdrawn",
            "superseded"
          ]
        },
        "previous_state": {
          "$ref": "#/$defs/previous_state"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "history": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "properties": {
          "successor": {
            "$ref": "#/$defs/lineage"
          }
        }
      },
      "else": {
        "properties": {
          "successor": {
            "type": "null"
          }
        }
      }
    }
  ]
}
